# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Keep false while the ten sample records are unverified.
SITE_INDEXABLE=false
INQUIRIES_ENABLED=false
# Local development reads the checked-in review catalog.
# Online test: supabase + true, with a separate test database and server secret.
CATALOG_SOURCE=file
CATALOG_INCLUDE_SAMPLES=false
