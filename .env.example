# Copy to .env.local in the project root. Never commit credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false while the ten sample records are unverified.
SITE_INDEXABLE=false
# Firebase inquiry/CRM persistence is not implemented.
# Changing this flag cannot enable intake in the current code.
INQUIRIES_ENABLED=false
# Local development reads the sanitized checked-in review catalog.
# Use firebase only after the named database, rules and import are verified.
CATALOG_SOURCE=file
CATALOG_INCLUDE_SAMPLES=false
# These are identifiers, not credentials. Catalog reads need no API secret.
FIREBASE_PROJECT_ID=tavan-tansag-30560
FIRESTORE_DATABASE_ID=tavan-tansag-preview
# Chosen database location: Tokyo (asia-northeast1).
# Optional exact origin for request validation, without a trailing slash.
# SITE_ORIGIN=http://localhost:3000
