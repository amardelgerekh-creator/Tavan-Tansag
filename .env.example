# Copy to .env.local in the project root. Never commit credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false while the ten sample records are unverified.
SITE_INDEXABLE=false
# Optional Search Console ownership code. Set only the real code from Google.
GOOGLE_SITE_VERIFICATION=
# Intake is closed until WIF, hashing and staff access below are configured.
INQUIRIES_ENABLED=false
# Local development reads the sanitized checked-in review catalog.
# Use firebase only after the named database, rules and import are verified.
CATALOG_SOURCE=file
CATALOG_INCLUDE_SAMPLES=false
# These are identifiers, not credentials. Catalog reads need no API secret.
FIREBASE_PROJECT_ID=tavan-tansag-30560
FIRESTORE_DATABASE_ID=tavan-tansag-preview
# Chosen database location: Tokyo (asia-northeast1).
# Optional exact origin for request validation, without a trailing slash.
# SITE_ORIGIN=http://localhost:3000

# Keyless private storage. Production identity only; no service account key.
GCP_PROJECT_NUMBER=1081274110553
GCP_SERVICE_ACCOUNT_EMAIL=tavan-website@tavan-tansag-30560.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=tavan-vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# Server-only random value of at least 32 characters; never commit a real value.
INQUIRY_HASH_SECRET=
# Comma-separated verified Google accounts permitted to use the CRM.
STAFF_EMAILS=
# Firebase web application identifiers; API key is public client configuration.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=

# Owner-only new-request email notifications. Enable after provider and queue verification.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
# A verified Resend sender; never put customer-supplied values here.
NOTIFICATION_FROM=
# Random server secret, minimum 32 characters, for the daily recovery cron.
CRON_SECRET=
